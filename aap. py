                out["fii"] = (float(row.get("buyValue") or 0), float(row.get("sellValue") or 0))
            elif cat.startswith("DII"):
                out["dii"] = (float(row.get("buyValue") or 0), float(row.get("sellValue") or 0))
            out["date"] = row.get("date")
